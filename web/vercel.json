{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && exit 1; git diff --quiet HEAD^ HEAD -- . || exit 1",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "erros.auri.dev.br"
        }
      ],
      "destination": "https://auri.dev.br/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "atualizacoes.auri.dev.br"
        }
      ],
      "destination": "https://auri.dev.br/",
      "permanent": false
    },
    {
      "source": "/auri-:version([0-9][^/]*)-setup.exe",
      "destination": "https://github.com/GuilhermeBrun/auri/releases/download/v:version/auri-:version-setup.exe",
      "permanent": false
    },
    {
      "source": "/auri-:version([0-9][^/]*)-arm64.dmg",
      "destination": "https://github.com/GuilhermeBrun/auri/releases/download/v:version/auri-:version-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/Auri-:version([0-9][^/]*)-arm64-mac.zip",
      "destination": "https://github.com/GuilhermeBrun/auri/releases/download/v:version/Auri-:version-arm64-mac.zip",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assinar",
      "destination": "/assinar/index.html"
    },
    {
      "source": "/recebido",
      "destination": "/recebido/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!assinar|recebido).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(assinar|recebido)(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
