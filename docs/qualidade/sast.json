{
  "rules": [
    {
      "id": "auri-electron-isolation",
      "languages": ["typescript", "javascript"],
      "message": "Preserve isolamento, sandbox e webSecurity do renderer.",
      "severity": "ERROR",
      "pattern-either": [
        { "pattern": "{nodeIntegration: true, ...}" },
        { "pattern": "{contextIsolation: false, ...}" },
        { "pattern": "{sandbox: false, ...}" },
        { "pattern": "{webSecurity: false, ...}" }
      ],
      "metadata": {
        "unsafe": "new BrowserWindow({webPreferences: {nodeIntegration: true}})",
        "safe": "new BrowserWindow({webPreferences: {nodeIntegration: false, contextIsolation: true, sandbox: true}})"
      }
    },
    {
      "id": "auri-dynamic-code",
      "languages": ["typescript", "javascript"],
      "message": "Não execute código construído a partir de texto.",
      "severity": "ERROR",
      "pattern-either": [{ "pattern": "eval(...)" }, { "pattern": "new Function(...)" }],
      "metadata": { "unsafe": "eval(input)", "safe": "JSON.parse(input)" }
    },
    {
      "id": "auri-tls-verification",
      "languages": ["typescript", "javascript"],
      "message": "Não desative a verificação do certificado TLS.",
      "severity": "ERROR",
      "pattern": "{rejectUnauthorized: false, ...}",
      "metadata": {
        "unsafe": "request({rejectUnauthorized: false})",
        "safe": "request({rejectUnauthorized: true})"
      }
    },
    {
      "id": "auri-shell-execution",
      "languages": ["typescript", "javascript"],
      "message": "Execute programas com argumentos separados, sem shell.",
      "severity": "ERROR",
      "pattern": "{shell: true, ...}",
      "metadata": {
        "unsafe": "spawn(program, args, {shell: true})",
        "safe": "execFile(program, args, {shell: false})"
      }
    },
    {
      "id": "auri-weak-crypto",
      "languages": ["typescript", "javascript"],
      "message": "Use criptografia autenticada e algoritmos atuais.",
      "severity": "ERROR",
      "pattern-either": [
        { "pattern": "createCipher(...)" },
        { "pattern": "createDecipher(...)" },
        { "pattern": "createHash('md5')" },
        { "pattern": "createHash('sha1')" }
      ],
      "metadata": {
        "unsafe": "import {createHash} from 'node:crypto'; createHash('md5')",
        "safe": "import {createHash} from 'node:crypto'; createHash('sha256')"
      }
    },
    {
      "id": "auri-html-injection",
      "languages": ["typescript", "javascript"],
      "message": "Renderize conteúdo como texto; HTML arbitrário requer política específica.",
      "severity": "ERROR",
      "pattern-either": [
        { "pattern": "$ELEMENT.innerHTML = $HTML" },
        { "pattern": "<$TAG dangerouslySetInnerHTML={$HTML} />" }
      ],
      "metadata": { "unsafe": "element.innerHTML = input", "safe": "element.textContent = input" }
    },
    {
      "id": "auri-preload-capabilities",
      "languages": ["typescript", "javascript"],
      "message": "Exponha somente métodos delimitados; não entregue ipcRenderer ao renderer.",
      "severity": "ERROR",
      "pattern-either": [
        { "pattern": "contextBridge.exposeInMainWorld($NAME, ipcRenderer)" },
        { "pattern": "contextBridge.exposeInMainWorld($NAME, {ipcRenderer: ipcRenderer, ...})" }
      ],
      "metadata": {
        "unsafe": "contextBridge.exposeInMainWorld('api', ipcRenderer)",
        "safe": "contextBridge.exposeInMainWorld('api', {list: () => ipcRenderer.invoke('patients:list')})"
      }
    },
    {
      "id": "auri-ipc-sender",
      "languages": ["typescript", "javascript"],
      "message": "Todo handler IPC precisa validar o remetente com assertTrustedSender.",
      "severity": "ERROR",
      "patterns": [
        {
          "pattern-either": [
            { "pattern": "ipcMain.handle($CHANNEL, ($EVENT, ...) => { ... })" },
            { "pattern": "ipcMain.handle($CHANNEL, async ($EVENT, ...) => { ... })" }
          ]
        },
        {
          "pattern-not": "ipcMain.handle($CHANNEL, ($EVENT, ...) => { ... assertTrustedSender($EVENT); ... })"
        },
        {
          "pattern-not": "ipcMain.handle($CHANNEL, async ($EVENT, ...) => { ... assertTrustedSender($EVENT); ... })"
        },
        {
          "pattern-not": "ipcMain.handle($CHANNEL, ($EVENT, ...) => { ... try { ... assertTrustedSender($EVENT); ... } catch ($ERROR) { ... } ... })"
        },
        {
          "pattern-not": "ipcMain.handle($CHANNEL, async ($EVENT, ...) => { ... try { ... assertTrustedSender($EVENT); ... } catch ($ERROR) { ... } ... })"
        }
      ],
      "metadata": {
        "unsafe": "ipcMain.handle('read', (event, value) => { return read(value) })",
        "safe": "ipcMain.handle('read', async (event, value) => { try { assertTrustedSender(event); return read(value) } catch (error) { return {error} } })"
      }
    }
  ]
}
