  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./out/main/index.js",
  "author": "Auri",
  "scripts": {
    "format": "vp fmt",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "node scripts/run-tests.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "vp config --hooks-dir .vite-hooks --no-agent || true",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "format:check": "vp fmt --check",
    "lint:ci": "vp lint --max-warnings=0",
    "test:e2e": "node scripts/e2e.mjs .quality/e2e",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:mac": "node scripts/ci-local.mjs mac",
    "ci:ios": "node scripts/ci-local.mjs ios",
    "check": "vp check",
    "test:ui": "node scripts/quality/ui.mjs",
    "test:package": "node scripts/quality/package.mjs",
    "test:installer": "node scripts/quality/install.mjs",
    "visual:aceitar": "node scripts/quality/visual-accept.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hyperswarm/secret-stream": "^6.9.2",
    "better-sqlite3": "^13.0.3",
