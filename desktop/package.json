    "lucide-react": "^1.59.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
