{
  "name": "auri",
  "version": "1.0.0",
  "description": "Cadastro de pacientes e agenda para clínica de fonoaudiologia",
  "main": "./out/main/index.js",
  "author": "Auri",
  "scripts": {
    "format": "vp fmt",
    "lint": "vp lint",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/run-tests.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "format:check": "vp fmt --check",
    "lint:ci": "vp lint --max-warnings=0",
    "test:ci": "node scripts/run-tests.mjs --quality",
    "test:quality": "node --test scripts/quality/*.test.mjs",
    "test:coverage-changed": "node scripts/quality/changed-coverage.mjs",
    "test:performance": "node scripts/quality/performance.mjs",
    "security:sast": "node scripts/quality/sast.mjs",
    "quality:delivery": "node scripts/quality/delivery.mjs",
    "test:e2e": "node scripts/e2e.mjs .quality/e2e",
    "security:check": "node scripts/quality/security.mjs",
    "quality:policy": "node scripts/quality/cli.mjs policy",
    "quality:validate": "node scripts/quality/cli.mjs validate",
    "quality": "node scripts/quality/cli.mjs local",
    "quality:protect": "node scripts/quality/enable-protection.mjs",
    "check": "vp check",
    "test:ui": "node scripts/quality/ui.mjs",
    "test:mutation": "node scripts/quality/mutation.mjs",
    "test:package": "node scripts/quality/package.mjs",
    "test:installer": "node scripts/quality/install.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hyperswarm/secret-stream": "^6.9.2",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "hyperdht": "^6.34.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lucide-react": "^1.52.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plus": "1.2.0"
  },
  "productName": "Auri",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.13.0"
}
